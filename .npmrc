# Hoisted node-linker so workspace packages resolve their built dist via plain
# symlinks into the source tree. With the default isolated linker, pnpm places
# a content-addressed hardlink copy of @immich/sdk under .pnpm that does NOT
# include the build/ output produced by `tsc`, so @immich/plugin-sdk's esbuild
# fails to resolve "@immich/sdk" -> ./build/index.js. Hoisting symlinks the
# workspace package directly, making build/ visible immediately after build.
node-linker=hoisted
# Resilient network settings: the npm registry occasionally times out on
# individual tarballs (e.g. geo-tz) under GHA runners. More retries + a
# longer per-request timeout lets pnpm ride out transient failures instead
# of aborting the whole install after the default 2 retries / 60s.
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
fetch-timeout=300000
